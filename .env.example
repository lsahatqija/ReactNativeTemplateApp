# Copy this file to .env and fill in real values for local development.
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time — they are
# PUBLIC, not secret. Never put API keys, tokens, or credentials in these variables.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Base URL the typed API client (src/api/client.ts) sends requests to.
EXPO_PUBLIC_API_URL=https://api.example.dev
